{
  "name": "lf-ui-components",
  "version": "21.0.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Laserfiche/lf-ui-components"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "npm run build-ui-components-prod && npm run build-lf-documentation-prod && npm run build-lf-cdn-prod && npm run sass-lf && npm run sass-ms",
    "build-lf-documentation-dev": "npm run sass-lf && npm run sass-ms && ng build lf-documentation --configuration development --delete-output-path false",
    "build-lf-documentation-dev-watch": "npm run sass-lf && npm run sass-ms && ng build lf-documentation --configuration development --delete-output-path false --watch",
    "build-lf-documentation-prod": "ng build lf-documentation --configuration production --output-hashing=none",
    "build-lf-cdn-prod": "ng build lf-cdn --configuration production --output-hashing=none",
    "build-lf-cdn-dev": "ng build lf-cdn --configuration development --output-hashing=none",
    "build-ui-components-prod": "ng build ui-components --configuration production",
    "build-ui-components-dev": "ng build ui-components --configuration development",
    "build-ui-components-dev-watch": "ng build ui-components --configuration development --watch",
    "test": "vitest --browser.enabled --run",
    "test:ci": "vitest --browser.enabled --run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "ng lint",
    "tsc-cdn": "tsc --project ./projects/lf-cdn/tsconfig.app.json",
    "api-extractor": "api-extractor run --local",
    "sass-lf": "sass projects/styles/lf-laserfiche-lite/lf-laserfiche-lite.scss:dist/lf-documentation/browser/lf-laserfiche-lite.css",
    "sass-ms": "sass projects/styles/lf-ms-office/lf-ms-office-lite.scss:dist/lf-documentation/browser/lf-ms-office-lite.css",
    "rename-lf-cdn": "gulp renameLfCdn",
    "create-lf-cdn": "npm run build-lf-cdn-prod && npm run rename-lf-cdn",
    "build-enum-types": "tsc projects/ui-components/shared/enums.ts --outDir types-lf-ui-components-publish --module es2022 --target es2022 --declaration false --skipLibCheck --moduleResolution node && node -e \"require('fs').renameSync('types-lf-ui-components-publish/enums.js','types-lf-ui-components-publish/index.js')\"",
    "create-types-lf-ui-components": "npm run tsc-cdn && npm run api-extractor && gulp processTypesFile && npm run build-enum-types && cd ./types-lf-ui-components-publish && npm pack",
    "gulp-replace-placeholders-in-documentation": "gulp replacePlaceholdersInDocumentation"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.3.1",
    "@analogjs/vitest-angular": "^2.3.1",
    "@angular-devkit/build-angular": "^21.2.2",
    "@angular-eslint/builder": "^21.3.0",
    "@angular-eslint/schematics": "^21.3.0",
    "@angular/cli": "^21.2.2",
    "@microsoft/api-extractor": "^7.57.7",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/lodash": "^4.17.24",
    "@types/node": "^24.12.0",
    "@vitest/browser": "^4.1.0",
    "@vitest/browser-playwright": "^4.1.0",
    "angular-eslint": "^21.3.0",
    "date-fns": "^4.1.0",
    "eslint": "^10.0.3",
    "flatpickr": "^4.6.13",
    "gulp": "^5.0.1",
    "gulp-replace": "^1.1.4",
    "ng-packagr": "^21.2.0",
    "prettier": "^3.8.1",
    "puppeteer": "^24.39.1",
    "tslib": "^2.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.57.0",
    "vitest": "^4.1.0",
    "yargs": "^18.0.0"
  },
  "peerDependencies": {
    "@angular/animations": "^21.2.4",
    "@angular/cdk": "^21.2.2",
    "@angular/common": "^21.2.4",
    "@angular/compiler": "^21.2.4",
    "@angular/compiler-cli": "^21.2.4",
    "@angular/core": "^21.2.4",
    "@angular/elements": "^21.2.4",
    "@angular/forms": "^21.2.4",
    "@angular/material": "^21.2.2",
    "@angular/platform-browser": "^21.2.4",
    "@angular/router": "^21.2.4",
    "@laserfiche/lf-api-client-core": "^1.1.19",
    "@laserfiche/lf-js-utils": "^4.0.13",
    "@laserfiche/lf-resource-library": "^5.0.3",
    "ngx-mask": "^21.0.1",
    "rxjs": "^7.8.0"
  },
  "dependencies": {
    "@laserfiche/lf-ui-components": "file:projects/ui-components"
  }
}
