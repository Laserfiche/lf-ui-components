{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "lf-cdn": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:application": {
          "strict": true
        }
      },
      "root": "projects/lf-cdn",
      "sourceRoot": "projects/lf-cdn/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/lf-cdn",
            "index": "projects/lf-cdn/src/index.html",
            "polyfills": [],
            "tsConfig": "projects/lf-cdn/tsconfig.app.json",
            "assets": [
              "projects/lf-cdn/src/favicon.ico",
              "projects/lf-cdn/src/assets",
              {
                "glob": "*",
                "input": "projects/static-assets",
                "output": ""
              }
            ],
            "styles": ["projects/lf-cdn/src/styles.css"],
            "scripts": [],
            "browser": "projects/lf-cdn/src/main.ts"
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                {
                  "replace": "projects/lf-cdn/src/environments/environment.ts",
                  "with": "projects/lf-cdn/src/environments/environment.prod.ts"
                }
              ],
              "optimization": {
                "scripts": true,
                "fonts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                }
              },
              "outputHashing": "all",
              "sourceMap": true,
              "namedChunks": false,
              "extractLicenses": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2mb",
                  "maximumError": "5mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb",
                  "maximumError": "10kb"
                }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            }
          },
          "defaultConfiguration": ""
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "lf-cdn:build"
          },
          "configurations": {
            "production": {
              "buildTarget": "lf-cdn:build:production"
            }
          }
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "buildTarget": "lf-cdn:build"
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/lf-cdn/tsconfig.spec.json"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["projects/lf-cdn/**/*.ts", "projects/lf-cdn/**/*.html"]
          }
        }
      }
    },
    "lf-documentation": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:application": {
          "strict": true
        }
      },
      "root": "projects/lf-documentation",
      "sourceRoot": "projects/lf-documentation/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/lf-documentation",
            "index": "projects/lf-documentation/src/index.html",
            "polyfills": [],
            "tsConfig": "projects/lf-documentation/tsconfig.app.json",
            "assets": [
              "projects/lf-documentation/src/favicon.ico",
              "projects/lf-documentation/src/assets",
              {
                "glob": "*",
                "input": "projects/static-assets",
                "output": ""
              },
              {
                "glob": "lf-*-lite.css",
                "input": "dist/generated-assets",
                "output": ""
              },
              {
                "glob": "lf-*-lite.css.map",
                "input": "dist/generated-assets",
                "output": ""
              },
              {
                "glob": "lf-ui-components.js",
                "input": "dist/lf-cdn/browser",
                "output": ""
              }
            ],
            "styles": ["projects/lf-documentation/src/styles.css", "./node_modules/flatpickr/dist/flatpickr.min.css"],
            "scripts": [],
            "browser": "projects/lf-documentation/src/main.ts"
          },
          "configurations": {
            "production": {
              "optimization": true,
              "sourceMap": true,
              "namedChunks": false,
              "extractLicenses": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "3mb",
                  "maximumError": "3mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2kb",
                  "maximumError": "6kb"
                }
              ],
              "fileReplacements": [
                {
                  "replace": "projects/lf-documentation/src/environments/environment.ts",
                  "with": "projects/lf-documentation/src/environments/environment.prod.ts"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            }
          },
          "defaultConfiguration": ""
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "lf-documentation:build:production"
            },
            "development": {
              "buildTarget": "lf-documentation:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "buildTarget": "lf-documentation:build"
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/lf-documentation/tsconfig.spec.json",
            "browsers": ["chrome-headless"]
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["projects/lf-documentation/**/*.ts", "projects/lf-documentation/**/*.html"]
          }
        }
      }
    },
    "ui-components": {
      "projectType": "library",
      "root": "projects/ui-components",
      "sourceRoot": "projects/ui-components",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/ui-components/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/ui-components/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/ui-components/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/ui-components/tsconfig.spec.json",
            "browsers": ["chrome-headless"]
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["projects/ui-components/**/*.ts", "projects/ui-components/**/*.html"]
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
